{
  "name": "@q-sys/qrwc",
  "version": "0.4.0-beta",
  "description": "A websocket-based interface for Q-SYS controls.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.18.1"
  },
  "scripts": {
    "build": "npm run lint && tsc",
    "test:node": "npm run lint && jest --config jest.node.config.js",
    "test:frontend": "npm run lint && jest --config jest.jsdom.config.js",
    "test": "npm run lint && npm run test:node && npm run test:frontend",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "fix": "eslint --fix \"src/**/*.ts\" \"tests/**/*.ts\" && prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "git add"
    ]
  },
  "repository": {
    "type": "git"
  },
  "browser": {
    "./dist/event/EventEmitter.js": "./dist/event/EventEmitter.browser.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "globals": "16.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "mock-socket": "^9.3.1",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "./"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "dependencies": {
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  }
}
