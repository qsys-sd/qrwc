{
  "name": "@q-sys/qrwc",
  "version": "0.3.0-alpha",
  "description": "Interface software for Q-SYS controls.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "proprietary",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=16.18.1"
  },
  "scripts": {
    "build": "npm run lint && tsc",
    "test:node": "npm run lint && jest --config jest.node.config.js",
    "test:frontend": "npm run lint && jest --config jest.jsdom.config.js",
    "test": "npm run lint && npm run test:node && npm run test:frontend",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "fix": "eslint --fix 'src/**/*.ts' 'tests/**/*.ts' && prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run lint"
    }
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "git add"
    ]
  },
  "repository": {
    "type": "git"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^10.1.1",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^12.3.8",
    "mock-socket": "^9.3.1",
    "prettier": "^3.5.3",
    "ts-jest": "^29.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "./"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "dependencies": {
    "typescript": "^5.1.6",
    "uuid": "^9.0.0"
  }
}
